{
  "name": "@clawdbot/financial-datasets",
  "version": "0.1.0",
  "description": "Financial Datasets API integration for Clawdbot - stocks, crypto, macro, and news",
  "type": "module",
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "exports": {
    ".": {
      "import": "./dist/plugin.js",
      "types": "./dist/plugin.d.ts"
    }
  },
  "clawdbot": {
    "extensions": [
      "./dist/plugin.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "clawdbot": ">=2026.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "keywords": [
    "clawdbot",
    "financial",
    "stocks",
    "crypto",
    "news",
    "sec-filings",
    "financial-statements"
  ],
  "license": "MIT"
}
