{
  "allowedRoots": [
    {
      "path": "~/Nano-Clawd/container/skills",
      "allowReadWrite": false,
      "description": "Container skills mounted into every agent session (read-only)"
    },
    {
      "path": "~/Nano-Clawd/container/agent-runner/src",
      "allowReadWrite": false,
      "description": "Agent-runner source (read-only reference for self-modification flows)"
    },
    {
      "path": "~/Nano-Clawd/groups",
      "allowReadWrite": true,
      "description": "Per-agent-group filesystems (CLAUDE.md, skills, agent-runner-src overlays)"
    },
    {
      "path": "~/Nano-Clawd/data/v2-sessions",
      "allowReadWrite": true,
      "description": "Session inbound/outbound DBs"
    },
    {
      "path": "~/Nano-Clawd/Framework/src",
      "allowReadWrite": true,
      "description": "x402agent-nanoclawd Framework source (agent, identity, molting, pulse, skills, state, survival)"
    },
    {
      "path": "~/Nano-Clawd/Framework/dist",
      "allowReadWrite": true,
      "description": "Framework compiled output (leviathan/nanoclawd CLI binary target)"
    },
    {
      "path": "~/Nano-Clawd/Framework/packages",
      "allowReadWrite": true,
      "description": "Framework sub-packages (clawd, cli)"
    },
    {
      "path": "~/Nano-Clawd/Framework/examples",
      "allowReadWrite": true,
      "description": "Framework usage examples"
    },
    {
      "path": "~/projects",
      "allowReadWrite": true,
      "description": "Development projects"
    },
    {
      "path": "~/repos",
      "allowReadWrite": true,
      "description": "Git repositories"
    }
  ],
  "blockedPatterns": [
    "password",
    "secret",
    "token",
    ".env",
    "private"
  ],
  "nonMainReadOnly": true
}
